{
  "name": "md-viewer",
  "version": "1.1.0",
  "description": "自动检测并预览浏览器中的 Markdown 文件，支持目录导航、截图、搜索、设置、最近文件等功能",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "cross-env BUILD_MODE=web vite build",
    "build:web:local": "cross-env BUILD_MODE=web BUILD_TARGET=local vite build",
    "build:ext": "vite build",
    "build:crx": "npm run build:ext && node build-crx.js",
    "preview": "vite preview",
    "build:pack": "npm run build:ext && node build-crx.js"
  },
  "dependencies": {
    "dompurify": "^3.0.6",
    "highlight.js": "^11.9.0",
    "jspdf": "^4.2.1",
    "marked": "^11.1.0"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "cross-env": "^10.1.0",
    "terser": "^5.48.0",
    "vite": "^4.4.9"
  }
}
